# ============================================================
# Smart Document Verification Portal - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# Flask secret key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secret-key-change-this

# Flask environment: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL connection string
# Format: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/smart_doc_verify

# Upload settings
MAX_CONTENT_LENGTH_MB=10
TEMP_UPLOAD_FOLDER=temp_uploads

# Tesseract OCR path (Windows default)
# If Tesseract is installed elsewhere, update this path.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Admin account bootstrap (used only for initial seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Record retention: set to 1 to save sanitized metadata, 0 to disable
ENABLE_RECORD_RETENTION=1

# Rate limiting (verifications per minute per IP)
RATE_LIMIT_PER_MINUTE=10
