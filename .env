# ============================================================
# Smart Document Verification Portal - Environment Variables
# ============================================================

# Flask secret key
SECRET_KEY=af8cda5b0948d024226d2a10d7806e18c6fd6de60b5556e7b5af2c6a97b3e70b

# Flask environment
FLASK_APP=manage.py
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL connection string
# *** CHANGE 'yourpassword' to your actual MySQL root password ***
DATABASE_URL=mysql+pymysql://root:Sahil%401970@localhost:3306/smart_doc_verify

# Upload settings
MAX_CONTENT_LENGTH_MB=10
TEMP_UPLOAD_FOLDER=temp_uploads

# Tesseract OCR path (Windows default)
TESSERACT_CMD=E:\Tesseract-OCR\tesseract.exe

# Admin account bootstrap (used only for initial seed)
ADMIN_EMAIL=Admin@gmail.com
ADMIN_PASSWORD=Admin

# Record retention: set to 1 to save sanitized metadata, 0 to disable
ENABLE_RECORD_RETENTION=1

# Rate limiting (verifications per minute per IP)
RATE_LIMIT_PER_MINUTE=10
